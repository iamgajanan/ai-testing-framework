# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Non-privileged client key used together with the authenticated user's JWT.
# New Supabase projects: use the publishable key.
# Older projects: SUPABASE_ANON_KEY is also supported.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server/worker-only privileged key. Never put this in dashboard/.env.local.
# Required by the execution worker and privileged artifact operations.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional existing-name aliases supported by the backend:
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional AI provider configuration used by the testing engine.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
