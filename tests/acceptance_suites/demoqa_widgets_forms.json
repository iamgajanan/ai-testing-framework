    {"id":"dq-radio","name":"Radio button can be selected","url":"/radio-button","steps":[{"action":"click","selector":"label[for='yesRadio']"}],"validations":[{"type":"text_contains","selector":"#app","expected":"Yes"}]},
    {"id":"dq-buttons","name":"Double click produces confirmation","url":"/buttons","steps":[{"action":"click","selector":"#doubleClickBtn"}],"validations":[{"type":"text_contains","selector":"#doubleClickMessage","expected":"You have done a double click"}]},
    {"id":"dq-upload","name":"Upload control is present","url":"/upload-download","steps":[],"validations":[{"type":"element_present","selector":"#uploadFile"}]}
